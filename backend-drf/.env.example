# Copy to .env and fill in. .env is gitignored.
# SECRET_KEY: generate one, e.g. `python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"`
SECRET_KEY=
DEBUG=False
# Comma-separated hostnames allowed to hit the API
ALLOWED_HOSTS=localhost,127.0.0.1,.vercel.app
# Optional Postgres connection string (set on Railway/Render). Falls back to SQLite when absent.
DATABASE_URL=
