# Production build config — Vite reads this when building for Vercel.
# The Render backend URL is public (it's what the browser talks to), so it's
# safe to commit. Vercel dashboard env vars, if set, override these.
VITE_BACKEND_BASE_API=https://stock-prediction-backend-i2sg.onrender.com/api/v1
VITE_BACKEND_ROOT=https://stock-prediction-backend-i2sg.onrender.com
